# .env.example

# ── Required ──────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Optional — overrides defaults in app/config.py ───────────────────────────
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# MODEL_SLUG=meta-llama/llama-3.3-70b-instruct:free

# Attribution headers sent to OpenRouter (optional, good practice)
# HTTP_REFERER=https://your-project-url.example
# X_OPENROUTER_TITLE=Mini AI Document Summary API

# LLM request parameters
# LLM_TIMEOUT_SECONDS=45
# LLM_MAX_OUTPUT_TOKENS=1024
# LLM_TEMPERATURE=0.3

# File upload
# MAX_FILE_SIZE_MB=2

# Chunking (tokens; leave headroom from the 131K context window)
# CHUNK_TOKEN_THRESHOLD=100000

# PII redaction — set to false to disable before sending text to OpenRouter
# WARNING: when false, raw document content (including any PII) is sent to
# OpenRouter's free-tier endpoint, which may log prompts for model improvement.
# ENABLE_PII_REDACTION=true

# Per-client rate limit on POST /summarize (requests per minute)
# RATE_LIMIT_PER_MINUTE=10
